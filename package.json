    "e2e:real": "E2E_REAL=1 playwright test --grep @real"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "boring-avatars": "^2.0.4",
    "buffer": "^6.0.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
