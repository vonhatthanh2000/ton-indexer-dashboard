{
  "name": "observer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/next.mjs dev",
    "build": "next build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/next.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
