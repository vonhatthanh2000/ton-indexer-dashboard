# Port the dashboard listens on (always bound to 127.0.0.1). Read by `pnpm dev` / `pnpm start`.
PORT=3100
# ton-observer API base URL (server-side only; the browser only talks to this dashboard)
OBSERVER_API_URL=http://localhost:3000
# The chain ton-observer indexes: "testnet" (default) or "mainnet". Sets the Tonviewer links
# (testnet.tonviewer.com vs tonviewer.com). Inlined at build time: change it, then rebuild/redeploy.
NEXT_PUBLIC_TON_NETWORK=testnet
