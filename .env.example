# Port the dashboard listens on (always bound to 127.0.0.1). Read by `pnpm dev` / `pnpm start`.
PORT=3100
# ton-observer API base URL (server-side only)
OBSERVER_API_URL=http://localhost:3000
# At least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"`
SESSION_SECRET=
